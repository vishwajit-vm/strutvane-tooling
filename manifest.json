{
  "$comment": "Which canonical files are synced into which repos. A target's profile decides which files it gets: 'library' = TypeScript package repo, 'site' = docs site, 'meta' = hub and tooling. 'when: hasPackageJson' files only go to repos that already contain a package.json. Files without 'profiles' go to every profile. 'once: true' files are create-once: written only when the repo has no copy, never compared or overwritten afterwards (the repo owns them). 'retired' lists files that are no longer canonical: sync never deletes them, but --check reports any copy that is still there. A target folder that does not exist (not cloned, or not created yet) is skipped. contracts, core, cli and devkit were removed in v2: the framework absorbs them (hub docs/18 §3.2) and their repos will be archived.",
  "targets": [
    {
      "name": "framework",
      "profile": "library",
      "note": "Absorbs contracts, core, cli and devkit (v2, branch v2/consolidate; hub docs/18 §3.2)."
    },
    {
      "name": "auth",
      "profile": "library"
    },
    {
      "name": "ui",
      "profile": "library"
    },
    {
      "name": "create-strutvane",
      "profile": "library"
    },
    {
      "name": "logs",
      "profile": "library",
      "note": "Becomes strutvane-log-viewer (ADR-0022): the pipeline moves into the framework, the viewer stays here. Rename this target (name and dir) when the repo is renamed."
    },
    {
      "name": "files",
      "profile": "library"
    },
    {
      "name": "docs",
      "profile": "site"
    },
    {
      "name": "tooling",
      "profile": "meta"
    },
    {
      "name": "hub",
      "dir": "..",
      "profile": "meta"
    },
    {
      "name": "design-crisp",
      "profile": "library",
      "note": "The default design (hub docs/18 §5.1; consistency 129)."
    },
    {
      "name": "design-vivid",
      "profile": "library",
      "note": "The alternative design (hub docs/18 §5.1; consistency 129)."
    }
  ],
  "files": [
    {
      "path": ".editorconfig",
      "when": "always"
    },
    {
      "path": ".gitattributes",
      "when": "always"
    },
    {
      "path": ".claude/ECOSYSTEM.md",
      "when": "always"
    },
    {
      "path": ".claude/agents/strutvane-ecosystem-guardian.md",
      "when": "always"
    },
    {
      "path": ".claude/skills/strutvane-contribute/SKILL.md",
      "when": "always"
    },
    {
      "path": ".gitignore",
      "when": "always",
      "profiles": ["library"]
    },
    {
      "path": ".npmrc",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": "tsconfig.base.json",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": "biome.base.json",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": "vitest.shared.ts",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": "vitest.perf.config.ts",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": ".github/workflows/ci.yml",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": ".github/workflows/release.yml",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": ".github/dependabot.yml",
      "when": "hasPackageJson"
    },
    {
      "path": ".github/scripts/publish-if-new.mjs",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": ".github/scripts/check-deps.mjs",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": ".github/scripts/check-code-rules.mjs",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": ".github/scripts/check-package.mjs",
      "when": "hasPackageJson",
      "profiles": ["library"]
    },
    {
      "path": ".github/workflows/scorecard.yml",
      "when": "hasPackageJson",
      "profiles": ["library", "meta"]
    },
    {
      "path": "RELEASE-READINESS.md",
      "when": "hasPackageJson",
      "profiles": ["library"],
      "once": true
    }
  ],
  "retired": [
    {
      "path": ".github/scripts/workspace-packages.mjs",
      "reason": "Retired in v2: every repo publishes one package from its root, so publish-if-new.mjs and check-deps.mjs no longer read pnpm-workspace.yaml.",
      "profiles": ["library"]
    }
  ]
}
