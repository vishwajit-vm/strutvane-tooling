{
  "name": "@strutvane/tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical configs, CI workflows and the config-sync script shared by every Strutvane package repo.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "sync:dry": "node scripts/sync.mjs --dry-run",
    "test": "node --test \"scripts/*.test.mjs\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ci": "biome check . && node --test \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "yaml": "2.9.1"
  }
}
